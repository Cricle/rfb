<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-target: netstandard2.0/2.1 for broad ecosystem compatibility,
         net8.0 for the in-box System.Text.Json / modern API surface. -->
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Rfb.Sdk</RootNamespace>
    <AssemblyName>Rfb.Sdk</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- NuGet 包元数据；CI 发布时用 tag 覆盖 Version（-p:Version=...） -->
    <PackageId>Rfb.Sdk</PackageId>
    <Version>0.0.1</Version>
    <Authors>Cricle</Authors>
    <Description>RFB unified SDK (C#): RfbClient facade over forkd controller, forkd guest and ZBRT v1 — mirror port of the Rust reference implementation</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Cricle/rfb</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!-- System.Text.Json ships in-box only for net8.0; older targets get the
       NuGet package (supports netstandard2.0/2.1). -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rfb.Sdk.Tests" />
  </ItemGroup>

</Project>
