<?xml version="1.0" encoding="utf-8"?>
<!-- 本地源：`dotnet pack ../../src/Rfb.Sdk -o local-nuget` 之后，未发布的
     SDK 版本（如带 Sandbox.Attach 的 0.0.3）从这里恢复；目录不存在时该源
     自动跳过，外部用户照常走 nuget.org。 -->
<configuration>
  <packageSources>
    <add key="local" value="local-nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
